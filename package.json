{
  "name": "@unspendablelabs/kontor-portal-client",
  "version": "0.2.10",
  "type": "module",
  "description": "TypeScript client for Kontor Portal — BLS registration, challenge login, and chunked file upload",
  "license": "MIT",
  "author": "Kontor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnspendableLabs/Kontor-Portal-Client.git"
  },
  "keywords": [
    "kontor",
    "portal",
    "horizon",
    "bls",
    "bitcoin",
    "file-storage"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./bls": {
      "types": "./dist/bls-primitives.d.ts",
      "import": "./dist/bls-primitives.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build && ([ -d .git ] && git config core.hooksPath .githooks || true)"
  },
  "peerDependencies": {
    "@bitcoinerlab/secp256k1": "^1.1.1",
    "@kontor/kontor-crypto": "^0.2.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "bip32": "^5.0.0-rc.0",
    "bitcoinjs-lib": "^7.0.0-rc.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@kontor/kontor-crypto": {
      "optional": true
    },
    "@noble/curves": {
      "optional": true
    },
    "@noble/hashes": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bitcoinerlab/secp256k1": "^1.1.1",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@eslint/js": "^10.0.1",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.4",
    "bip32": "^5.0.0-rc.0",
    "bitcoinjs-lib": "^7.0.0-rc.0",
    "eslint": "^10.2.0",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.5",
    "typescript": "^5",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}
